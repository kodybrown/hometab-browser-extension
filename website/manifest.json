{
    "manifest_version": 3,
    "name": "HomeTab",
    "version": "2.0.0",
    "description": "Your homepage and page-capture tool, saved in a portable bookmarks.html file.",
    "permissions": ["activeTab", "contextMenus"],
    "optional_permissions": ["favicon"],
    "action": {
        "default_title": "Add to HomeTab",
        "default_popup": "capture.html",
        "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
    },
    "icons": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" },
    "background": { "service_worker": "background.js" },
    "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+H" } } },
    "chrome_url_overrides": {
        "newtab": "index.html"
    }
}
